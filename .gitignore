# ---- 虚拟环境 ----
.venv/
venv/
env/

# ---- Python 缓存与构建产物 ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- 运行期配置（含本机扫描结果与绝对路径，不公开）----
config.json

# ---- 运行产物（报告 / 日志 / points.json）----
# 演示报告已单独复制到 docs/demo/，可公开查看
reports/

# ---- 打包产物 ----
dist/

# ---- 自动下载/随包分发的推理引擎（体积很大，不入库）----
# 注意：仓库不入库 ≠ 发布包不含。scripts/make_release_zip.py 会把
# llama.cpp/ 与 models/ 一并打进 dist/*.zip，用于「开箱即用」发布。
llama.cpp/

# ---- 随包分发的默认模型（约 811MB，绝不入库）----
models/

# ---- 内部工作区数据 ----
.workbuddy/

# ---- 测试产物（可再生成）----
tests/_results.json

# ---- 编辑器 / 操作系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
